{
  "name": "mcp-zalo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server + bot tự trả lời cho Zalo cá nhân, dựa trên kiến thức đã nạp",
  "scripts": {
    "build": "tsc",
    "login": "tsx src/cli-login.ts",
    "bot": "tsx src/bot.ts",
    "mcp": "tsx src/mcp.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx src/pipeline.test.mts && tsx src/docs.test.mts && tsx src/media.test.mts && tsx src/mediaread.test.mts && tsx src/admin.test.mts && tsx src/history.test.mts",
    "sample-template": "tsx src/sample-template.ts",
    "test:live": "tsx src/live.test.mts",
    "backup": "bash deploy/backup.sh",
    "kiemtra": "tsx src/doctor.ts",
    "lay-lich-su": "tsx src/cli-history.ts",
    "lenh": "tsx src/cli-command.ts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "docx": "^9.16.0",
    "docxtemplater": "^3.71.1",
    "exceljs": "^4.4.0",
    "mammoth": "^1.13.0",
    "pizzip": "^3.3.0",
    "unpdf": "^1.9.1",
    "zca-js": "^2.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}